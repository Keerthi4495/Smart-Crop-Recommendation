# OpenAI API key used only by the server-side AI Assistance backend.
FARM_ASSISTANT_API_KEY=

# Optional: override the defaults for an OpenAI-compatible provider.
# FARM_ASSISTANT_API_URL=https://api.openai.com/v1/chat/completions
# FARM_ASSISTANT_MODEL=gpt-4o-mini

